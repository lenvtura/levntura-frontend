
# Postgres connection string.
# Local dev example:   postgres://postgres:admin@localhost:5433/levntura
# Production example:  postgresql://user:password@db.host.com:5432/levntura?sslmode=require
DATABASE_URL=

# Encryption / session key. Generate with: openssl rand -base64 32
# Changing it invalidates all existing logins.
PAYLOAD_SECRET=

# The site's single public domain. Used by Payload (serverURL / CORS / CSRF),
# the sitemap / robots / SEO, and media URLs.
# Dev:        http://localhost:3000
# Production: https://www.levntura.com
# Multiple origins allowed, comma-separated (no spaces):
#   https://levntura.com,https://www.levntura.com
#
# Vercel: set this to the real public HTTPS origin (Production + Preview).
# Do NOT leave http://localhost:3000 on Vercel — /admin will go blank.
# Preview URLs (*.vercel.app) are also added automatically via VERCEL_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# ===== Seed admin (used on first seed) =====
# The bootstrap admin created by `pnpm seed`. If unset, defaults to
# admin@admin.com — set these before deploying to production.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_NAME=
FIRST_ADMIN_PASSWORD=


# ===== Optional =====

# Override only if Payload must use a different origin than NEXT_PUBLIC_SITE_URL
# (rare — normally leave this unset).
# PAYLOAD_PUBLIC_SERVER_URL=

# Default "to" address for form-builder when a form has no recipient set.
# (Actual SMTP sending is configured in the admin: Site Settings → Email.)
DEFAULT_NOTIFICATION_EMAIL=admin@levntura.com

# Guards the on-demand browser seed endpoints (/api/admin/seed-*). Only needed
# if you seed from the browser; seeding over SSH (`pnpm seed:all`) ignores it.
PAYLOAD_PREVIEW_SECRET=


# ===== Storage (DigitalOcean Spaces / S3-compatible) =====
# Leave empty to use the local /media folder (good for dev).
# Set all 5 to enable Spaces uploads (recommended for production).
# The bucket must be public-read for images to display.
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_ACCESS_KEY=
DO_SPACES_SECRET_KEY=
